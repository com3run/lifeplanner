ALTER TABLE UserActivityPatternEntity ADD COLUMN featureEngagementJson TEXT NOT NULL DEFAULT '{}';
ALTER TABLE UserActivityPatternEntity ADD COLUMN sessionAvgMinutes REAL NOT NULL DEFAULT 0.0;
ALTER TABLE UserActivityPatternEntity ADD COLUMN sessionsPerWeek REAL NOT NULL DEFAULT 0.0;

CREATE TABLE IF NOT EXISTS ScreenTimeEventEntity (
    id TEXT PRIMARY KEY NOT NULL,
    screen TEXT NOT NULL,
    eventType TEXT NOT NULL,
    timestamp TEXT NOT NULL,
    durationMs INTEGER NOT NULL DEFAULT 0,
    date TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_screen_event_date ON ScreenTimeEventEntity(date);
CREATE INDEX IF NOT EXISTS idx_screen_event_screen ON ScreenTimeEventEntity(screen);
