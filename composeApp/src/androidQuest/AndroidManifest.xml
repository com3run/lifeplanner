<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Health Connect not available on Meta Quest -->
    <uses-permission android:name="android.permission.health.READ_STEPS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" tools:node="remove" />
    <!-- Google AD_ID not available on Meta Quest -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <application
        android:name=".QuestMainApplication"
        tools:replace="android:name">

        <!-- Tell the Quest OS this is a launchable panel (2D) app so it appears in the library -->
        <activity android:name=".MainActivity" tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.PANEL" />
            </intent-filter>
        </activity>

        <!-- Remove Health Connect activity aliases not relevant on Quest -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:targetActivity=".MainActivity"
            tools:node="remove" />
        <activity-alias
            android:name="ViewPermissionUsageActivityNew"
            android:targetActivity=".MainActivity"
            tools:node="remove" />
    </application>

</manifest>
